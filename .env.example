# ==========================================================
# 申请入口（密钥不要发给任何人，也不要提交到版本库）
#   高德：https://console.amap.com
#   百炼：https://bailian.console.aliyun.com
# ==========================================================

# ---- 存储 ----
# 线路知识库采用仓库内文件化存储，不依赖数据库
ADMIN_REPOSITORY_DRIVER=memory
PORT=3000

# ---- 账号持久化（三选一，优先级从上到下）----
# 1) PostgreSQL：配置 DATABASE_URL 后自动走数据库，一致性最强，支持并发写入。
#    建表（幂等，首次接库执行一次）：npm run db:migrate
# 2) COS 对象存储：配置下面 COS_* 四件套即可，实例重建不丢，成本按实际用量计（KB 级数据约等于免费）。
#    局限：「读-改-写」非原子，同一瞬间并发注册可能互相覆盖，适合个人/小范围使用。
# 3) 都不配置：回退到容器本地文件 data/user-data/*.json，实例重建即丢，仅适合本地开发。
DATABASE_URL=

# ---- COS 对象存储（PostgreSQL 之外的低成本持久化方案）----
# 桶必须设为「私有读写」，否则账号密码哈希会随匿名读泄漏
COS_BUCKET=
COS_REGION=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ---- 用户会话签名密钥（生产环境必填）----
# 用于 HMAC-SHA256 签名登录会话 Cookie；生产环境缺失会直接抛错，禁止使用内置默认值
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---- 投稿后台查看鉴权（正式环境必填）----
# 设置后，访问 /admin 与 GET /api/admin/submissions 需带 ?token= 或 x-admin-token 头
# 生产环境(NODE_ENV=production)若未设置该变量，/admin 投稿台会直接锁定，避免投稿人联系方式等隐私公网泄露
ADMIN_VIEW_TOKEN=

# ---- 高德地图 · Web端(JS API)：浏览器端使用 ----
# 控制台 -> 应用管理 -> 我的应用 -> 添加 Key -> 服务平台选「Web端(JS API)」
# 注意：Key 与安全密钥必须配套使用，缺一不可（2021-12-02 后申请的 Key 强制要求）
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# ---- 高德地图 · Web服务：服务端使用 ----
# 同一控制台 -> 再添加一个 Key -> 服务平台选「Web服务」
# 与上面是两套独立 Key，不能互相替代
AMAP_WEB_SERVICE_KEY=

# ---- 阿里云百炼 DashScope：agent prefill 与 embedding 共用 ----
# 控制台 -> 开通 DashScope -> API-KEY 管理 -> 创建新的 API-KEY
AGENT_PREFILL_PROVIDER=qwen
AGENT_PREFILL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AGENT_PREFILL_API_KEY=
AGENT_PREFILL_MODEL=qwen-plus

# Alternative OpenAI-compatible provider example (e.g. DeepSeek):
# AGENT_PREFILL_PROVIDER=deepseek
# AGENT_PREFILL_API_URL=https://api.deepseek.com/v1/chat/completions
# AGENT_PREFILL_MODEL=deepseek-chat
